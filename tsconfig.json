{
  "compilerOptions": {
    "module": "esnext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmitHelpers": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "nativescript-jsx",
    "lib": ["ESNext", "dom"],
    "paths": {
      "~/*": ["./src/*"],
      "@/*": ["./src/*"],
      "nativescript-jsx/jsx-runtime": ["./types/nativescript-jsx/jsx-runtime.d.ts"],
      "nativescript-jsx/jsx-dev-runtime": ["./types/nativescript-jsx/jsx-dev-runtime.d.ts"]
    }
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx", "./types/**/*.d.ts"],
  "files": ["./references.d.ts"],
  "exclude": ["node_modules", "platforms"]
}
